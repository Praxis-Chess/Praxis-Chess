# Copy this file to .env (gitignored) and choose your own password.
# docker compose reads .env automatically from the project root.
#
# POSTGRES_PASSWORD only takes effect when the database volume is FIRST
# created. For an existing database, see "Changing the database password"
# in README.md.
#
# Spring Boot does not read .env. Either export POSTGRES_PASSWORD in the
# environment you run the backend from, or put the same value in your
# (gitignored) backend/src/main/resources/application.yml.
POSTGRES_PASSWORD=change-me
