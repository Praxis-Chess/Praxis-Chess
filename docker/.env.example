# Optional settings for the Docker install (docker/compose.yaml).
# Copy to docker/.env (gitignored) and uncomment what you need. Nothing here is
# required: without this file Praxis starts with the defaults below.

# ── Database ─────────────────────────────────────────────────────────────────
# Takes effect only when the database volume is first created. The database is
# not reachable from outside Docker, but choose your own anyway.
# POSTGRES_PASSWORD=change-me

# ── Chess.com ────────────────────────────────────────────────────────────────
# Normally entered in Settings. This only pre-fills it.
# CHESS_COM_USERNAME=

# ── Models (Ollama) ──────────────────────────────────────────────────────────
# Standard set, the default (~8.5 GB to download):
#   explanations + reports  qwen2.5:7b
#   Ask Prax                qwen3:4b-instruct  (must support tool calling)
#   checked commentary      praxis-grid-2b-r3  (trained for Praxis; built from
#                           huggingface.co/praxis-chess, ~1.3 GB)
#
# Light set (~3.8 GB): use the 4B model for explanations and reports too.
# Its explanation quality has not been measured against the 7B.
# PRAXIS_MOVE_MODEL=qwen3:4b-instruct
# PRAXIS_REPORT_MODEL=qwen3:4b-instruct
#
# Turn the checked commentary off (saves ~1.3 GB):
# PRAXIS_COMMENTARY_MODEL=

# Ollama image version. "latest" unless you need to pin one.
# OLLAMA_VERSION=latest

# ── Optional services ────────────────────────────────────────────────────────
# Comma-separated: voice (Prax speaks, ~300 MB, CPU), web (web research for
# general chess questions through a private SearXNG). Each also needs its
# switch below.
# COMPOSE_PROFILES=voice,web
# PRAXIS_VOICE=true
# PRAXIS_WEB=true
# Any long random string, e.g. the output of: openssl rand -hex 32
# SEARXNG_SECRET=

# ── Other ────────────────────────────────────────────────────────────────────
# Your time zone, so practice streaks roll over at your midnight, not UTC's.
# TZ=Asia/Kolkata
# Port on this computer (always bound to 127.0.0.1 only).
# PRAXIS_PORT=8086
# Image version to run, e.g. 1.3.0. "latest" by default.
# PRAXIS_VERSION=latest
